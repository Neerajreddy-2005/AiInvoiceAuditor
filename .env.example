# compose gives each container only the values it needs at runtime, so no
# value below ever ends up in an image layer.

# ---- Supabase project (database and login)
#      Create the tables first: backend/Database/supabase/setup.sql, then
#      setup_rls.sql. Host and project ref are in the Session pooler
#      connection string under the Connect button.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_PROJECT_REF=your-project-ref

# ---- One database role per service, created by setup.sql with
#      least-privilege grants. Use the passwords you set there.
AGENT_DB_USER=agent
AGENT_DB_PASSWORD=change-me-agent
ERP_DB_USER=mock_erp
ERP_DB_PASSWORD=change-me-erp

# ---- Who may use the app: comma-separated sign-in emails. Everyone else is refused.
REVIEWER_EMAILS=you@example.com

# ---- Secrets between the local services. Generate each with: openssl rand -hex 32
#      The services refuse to start while these still say change-me.
ERP_SERVICE_TOKEN=change-me-erp-token
QDRANT_API_KEY=change-me-qdrant-key
REDIS_PASSWORD=change-me-redis-password

# ---- Verifies the database server's identity. Download the CA certificate from
#      Supabase (Project Settings > Database > SSL Configuration), save it in
#      backend/certs/, then uncomment. Without it the connection is encrypted but
#      unverified. Set this in production.
# DB_SSLROOTCERT=/certs/prod-ca-2021.crt

# ---- Gemini API (used by the agent through LiteLLM)
#      Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional
# Override the models in backend/configs/agent.yaml:
# CHAT_MODEL=gemini/gemini-3.5-flash-lite
# EMBED_MODEL=gemini/gemini-embedding-001
LOG_LEVEL=INFO
